{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["vitest/globals"],
    "paths": {
      "@salvon/ui": ["./src/index.ts"],
      "@salvon/ui/esixs": ["./src/esixs/index.ts"]
    }
  },
  "include": ["src", "playground"]
}
