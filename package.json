{
  "name": "@winterskelig/salvon-ui",
  "version": "0.0.1",
  "license": "MIT",
  "author": "winterskelig",
  "type": "module",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esixs": {
      "types": "./dist/esixs.d.ts",
      "default": "./dist/esixs.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown && node -e \"require('fs').copyFileSync('src/styles/theme.css','dist/styles.css')\"",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && vitest run && npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
